# Copy to a real .env (or set these as Cloud Functions environment variables).
# Placeholder values only — NEVER commit a real .env or a real key file.

# Path to the Google service-account JSON key the function authenticates with.
# Locally: wherever you saved the downloaded key. In production, prefer
# attaching the service account to the function and mounting the key via
# Secret Manager instead of shipping a key file.
SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service-account-key.json

# The only package/product this endpoint will ever touch. Anything else is
# rejected with 403.
EXPECTED_PACKAGE_NAME=com.taugustincst.elderon
EXPECTED_PRODUCT_ID=full_unlock

# Local dev port (unused on Cloud Functions, which sets PORT itself).
PORT=8080
