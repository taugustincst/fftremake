<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The game is entirely local. The only permission the app holds is the
         one the Play Billing library adds for The Hollow Sky
         (com.android.vending.BILLING), which talks to the Play Store app on
         the device. INTERNET is removed below in case any library asks for
         it, so the game cannot reach the network even if it tried. That is
         also the whole of the Play data-safety story: nothing leaves the
         device. allowBackup is off for the same reason: a saved game is meant
         to stay on this device, not ride along in Android's own Auto Backup to
         the player's Google account. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- Playable with a keyboard and mouse too, so devices without a touch
         screen are not filtered out of the listing. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Elderon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.Elderon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
